#!/usr/bin/env bun
import { existsSync } from "node:fs";
import { resolve } from "node:path";

const root = resolve(import.meta.dirname, "..");
const messageFile = Bun.argv[2];
if (messageFile === undefined || messageFile.length === 0) {
  throw new Error("commit-msg: Git did not provide a commit message file.");
}

const commitlint = resolve(root, "node_modules/.bin/commitlint");
if (!existsSync(commitlint)) {
  throw new Error("commit-msg: dependencies are missing; run 'bun install --frozen-lockfile'.");
}

const result = Bun.spawnSync({
  cmd: ["bun", "--bun", commitlint, "--edit", messageFile],
  cwd: root,
  stdin: "inherit",
  stdout: "inherit",
  stderr: "inherit",
});
if (result.exitCode !== 0) throw new Error(`commit-msg: commitlint failed with ${result.exitCode}.`);
